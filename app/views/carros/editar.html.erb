<section class="text-center container">
    <h1>Mostrando o carro</h1>

    <hr>

    <div style="text-align: left">

        <form action="">
            <div> <strong>ID</strong>: <input type="text" value="<%= @carro.id %>"></div>
            <div> <strong>Modelo</strong>: <input type="text" value="<%= @carro.modelo %>"></div>
            <div> <strong>Ano</strong>: <input type="text" value="<%= @carro.ano %>"></div>

            <hr>  
            <button type="submit" class="btn btn-primary">Enviar</button>
            <a href="/carros" class="btn btn-warning">Voltar para a lista</a>
        </form>
    </div>
</section>
