<section class="text-center container">
    <h1>Mostrando o carro</h1>

    <hr>

    <div style="text-align: left">
        <div> <strong><th>ID</th></strong>: <%= @carro.id %></div>
        <div> <strong><th>Nome</th></strong>: <%= @carro.nome %></div>
        <div> <strong><th>Modelo</th></strong>: <%= @carro.modelo %></div>
        <div> <strong><th>Ano</th></strong>: <%= @carro.ano %></div>

        <hr>
        <a href="/carros" class="btn btn-warning">Voltar para a lista</a>
    </div>
</section>
